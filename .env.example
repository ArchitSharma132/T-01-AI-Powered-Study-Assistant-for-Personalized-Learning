# =============================================================================
# AI-Powered Study Assistant — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
#   cp .env.example .env
# =============================================================================

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://studyapp:studyapp_dev_pass@localhost:5432/studyassistant
POSTGRES_USER=studyapp
POSTGRES_PASSWORD=studyapp_dev_pass
POSTGRES_DB=studyassistant

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Ollama (Local LLM — no API cost) ---
# Ollama runs locally. Set the base URL where Ollama is serving.
# Default: http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
# API key for Ollama (only needed if using a remote/authenticated Ollama instance)
OLLAMA_API_KEY=
# Model to use for question generation (you have qwen2.5 already)
OLLAMA_CHAT_MODEL=qwen2.5
# Model to use for embeddings (pull with: ollama pull nomic-embed-text)
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- JWT Authentication ---
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_STRING
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- App ---
APP_NAME=AI Study Assistant
APP_VERSION=0.1.0
DEBUG=true
